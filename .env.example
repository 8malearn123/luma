# LUMA environment variables. Copy to .env.local for development.
# NEVER commit real secrets. Server-only values never reach the browser.

# ── required ──────────────────────────────────────────────
NODE_ENV=development
# development | review (private review build: sandbox/dev outbox/demo allowed) | production
LUMA_DEPLOYMENT=development
APP_BASE_URL=http://localhost:3000
# Application role: NOT the schema owner, so row-level security is enforced.
DATABASE_URL=postgres://luma_app:CHANGE_ME@127.0.0.1:5432/luma_dev
# Schema owner, used only by `npm run db:migrate` / seed.
MIGRATION_DATABASE_URL=postgres://luma_owner:CHANGE_ME@127.0.0.1:5432/luma_dev
APP_DB_ROLE=luma_app
# ≥32 random chars (openssl rand -hex 32). Signs codes, media URLs, analytics hashes.
SESSION_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts provider secrets at rest.
LUMA_ENCRYPTION_KEY=

# ── development / private demo only (refused when NODE_ENV=production) ──
# Verification codes go to /dev/outbox instead of a real provider (clearly labeled).
LUMA_DEV_OTP=0
# Demo quick sign-in cards on /auth/login for seeded is_demo users.
LUMA_DEMO_MODE=0
# Keep the legacy localStorage prototype pages reachable (public/*.html).
LUMA_LEGACY_PROTOTYPE=0
# Sandbox payment provider (simulated hosted checkout, signed webhooks, no money).
PAYMENTS_SANDBOX_ENABLED=0

# ── optional integrations (disconnected unless configured) ──
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
EMAIL_PROVIDER=none
SMS_PROVIDER=none
# AI: both key and model must be set; no default model is assumed.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=45000
# Documented price per 1M tokens in micro-USD (leave empty → cost recorded as unknown)
AI_PRICE_IN_PER_MTOK_MICROUSD=
AI_PRICE_OUT_PER_MTOK_MICROUSD=
# Moyasar adapter (written against public docs; NOT live-tested). Keys are stored
# per business (encrypted) — this only enables the adapter.
MOYASAR_ENABLED=0
MOYASAR_API_BASE=https://api.moyasar.com/v1
# Trend radar: allow fetching user-provided / configured source URLs (SSRF-guarded)
TRENDS_FETCH_ENABLED=0
DB_POOL_MAX=10
