{
  "name": "luma",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-test": "tsx scripts/reset-test-db.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:legacy": "playwright test -c tests/legacy-static/playwright.config.js"
  },
  "dependencies": {
    "next": "15.5.27",
    "pdfkit": "0.17.2",
    "postgres": "3.4.7",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.5",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "22.18.0",
    "@types/pdfkit": "0.17.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sanitize-html": "2.16.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
